# 字体设置
font-family = "BitstromWeraNerdFontMono-Regular"
font-style-bold = "Medium"
font-style-bold-italic = "Medium Italic"

# 稍微减小字体大小，可以根据你的屏幕和喜好调整
font-size = 15

# 字体加粗，尝试更自然的渲染效果
font-thicken = true


# 主题和样式
cursor-style = block
adjust-cell-height = 35%

# Gruvbox Dark Hard Theme
background = #282828
foreground = #ebdbb2
selection-background = #ebdbb2
selection-foreground = #282828
cursor-color = #ebdbb2
cursor-text = #282828
palette = 0=#282828
palette = 1=#cc241d
palette = 2=#98971a
palette = 3=#d79921
palette = 4=#458588
palette = 5=#b16286
palette = 6=#689d6a
palette = 7=#a89984
palette = 8=#928374
palette = 9=#fb4934
palette = 10=#b8bb26
palette = 11=#fabd2f
palette = 12=#83a598
palette = 13=#d3869b
palette = 14=#8ec07c
palette = 15=#ebdbb2

cursor-style = "bar"
cursor-style-blink = true

# 减少滚动历史，节省内存
scrollback-limit = 20000

# 减少水平边距，节省屏幕空间
window-padding-x = 15

# 统一垂直边距
window-padding-y = 15
window-save-state = "always"

# 背景不透明度
background-opacity = 0.7

# 背景模糊半径
background-blur-radius = 25

# 更安全的快捷键，避免冲突
keybind = global:alt+grave_accent=toggle_quick_terminal
